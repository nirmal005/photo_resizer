# Watermark settings for main.py (used only with --enable_watermark true).
# Copy this file to .env and adjust. .env is not committed to git.
#
# The watermark text is the 5-digit code at the start of each photo's file name,
# e.g. 12345_beach.jpg -> "12345". Photos without a code are not watermarked.

# Position on the photo, 0 to 1. 0,0 = top-left corner, 1,1 = bottom-right corner,
# 0.5,0.5 = centered. Measured on the photo as you view it (upright), and the
# text always stays fully inside the photo.
WATERMARK_X=0.95
WATERMARK_Y=0.95

# 0 = invisible, 1 = fully solid
WATERMARK_OPACITY=0.5

# Text height as a fraction of the photo's short side (0.06 = 6%, about 0.3 in on a 5x7)
WATERMARK_SIZE=0.06

# Color name (white, black, red, ...) or hex like #FFFFFF
WATERMARK_COLOR=white

# TrueType font file name or full path (falls back to Pillow's built-in font)
WATERMARK_FONT=arial.ttf
